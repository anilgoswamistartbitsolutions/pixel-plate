DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=change-this-admin-jwt-secret
CONFIG_ENCRYPTION_KEY=change-this-database-secret-encryption-key
# Platform key for the Sarvam Conversational AI agent builder runtime (apps.sarvam.ai),
# used by /api/voice-agent/runtime to proxy the browser Test Agent widget.
VOICE_API_KEY=enter-the-private-voice-platform-key
# Separate key your deployed app checks on incoming /api/agent-tools/* calls from the agent's
# webhook tools. Required once VOICE_API_PUBLIC is set to false. See docs/voice-agent-tools.md.
AGENT_TOOLS_API_KEY=enter-a-long-random-key
VOICE_API_PUBLIC=true
CRON_SECRET=replace-with-a-long-random-cron-secret
SUPER_ADMIN_EMAIL=owner@pixelplate.local
SUPER_ADMIN_USERNAME=pixelplate
SUPER_ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=manager@pixelplate.local
ADMIN_USERNAME=manager
ADMIN_PASSWORD=change-me-now
NEXT_PUBLIC_APP_URL=http://localhost:3010
